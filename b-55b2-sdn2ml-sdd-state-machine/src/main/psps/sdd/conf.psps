            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKFREE">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKFREE" type="ai">
                  <EPICSField name="DESC" value="Disk Free (MB)"/>
                  <EPICSField name="DTYP" value="sysmon"/>
                  <EPICSField name="EGU" value="MB"/>
                  <EPICSField name="INP" value="@disk_free:/"/>
                  <EPICSField name="MDEL" value="10"/>
                  <EPICSField name="PINI" value="YES"/>
                  <EPICSField name="PREC" value="0"/>
                  <EPICSField name="SCAN" value="I/O Intr"/>
                  <EPICSField name="VAL" value="NaN"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <macroGroup ID="USER"/>
      </template>
      <template name="iocmon"
                 version="721"
                 description="template for iocmon variables"
                 forEveryIOC="true"
                 userDefined="false"
                 system="false"
                 userCanInstanciate="false"
                 usesSubstitutionFiles="false"
                 required="true">
         <applicableToControlUnit>PSH</applicableToControlUnit>
         <applicableToControlUnit>PCF</applicableToControlUnit>
         <applicableToControlUnit>SRV</applicableToControlUnit>
         <location>iocmon.db</location>
         <EPICSDBDName>iocmon.dbd</EPICSDBDName>
         <EPICSLibraryName>iocmon</EPICSLibraryName>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBQSIZE">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-$(IOCTYPE)-CBQSIZE" type="ai">
