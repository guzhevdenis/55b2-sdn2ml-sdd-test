                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLT">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLT" type="calcout">
                  <EPICSField name="CALC"
                               value="((A&gt;=1?1:0)|(B&gt;=1?2:0)|(C&gt;=1?4:0)|(D&gt;=1?8:0))&amp;(B&gt;2?0:15)"/>
                  <EPICSField name="DESC" value="System health"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SYSHLTS"/>
                  <EPICSField name="HIGH" value="1"/>
                  <EPICSField name="HSV" value="MINOR"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.SEVR"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.SEVR"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKUTL.SEVR"/>
                  <EPICSField name="INPD" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-FDUTL.SEVR"/>
                  <EPICSField name="SCAN" value="1 second"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCL">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCL" type="calcout">
                  <EPICSField name="CALC"
                               value="(A&gt;=1?1:0)+(B&gt;=1?1:0)+(C&gt;=1?1:0)+(D&gt;=1?1:0)+((E&gt;=1?1:0)||(F&gt;=1?1:0))"/>
                  <EPICSField name="DESC" value="Local PV calculation for SHLT"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.SEVR"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.SEVR"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-DISKUTL.SEVR"/>
                  <EPICSField name="INPD" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-FDUTL.SEVR"/>
                  <EPICSField name="INPE" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PS.SEVR"/>
                  <EPICSField name="INPF" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PROCSTS.SEVR"/>
                  <EPICSField name="PHAS" value="6"/>
                  <EPICSField name="SCAN" value="1 second"/>
               </EPICSRecord>
            </EPICSAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLT">
            <direction>state</direction>
            <kind>discrete multi-state</kind>
            <external>true</external>
            <raisesAlarm>true</raisesAlarm>
            <archivingInfo enabled="true">
               <samplingMode>monitor</samplingMode>
               <samplingFrequency>1.0</samplingFrequency>
            </archivingInfo>
            <controlsArchivingGroup>false</controlsArchivingGroup>
            <storage>volatile</storage>
            <presentOnScreens>true</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLT" type="mbbi">
                  <EPICSField name="DESC" value="Synthesis Health Status"/>
                  <EPICSField name="INP" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTC"/>
                  <EPICSField name="ONST" value="Partially Operational(1)"/>
                  <EPICSField name="ONSV" value="MINOR"/>
                  <EPICSField name="ONVL" value="1"/>
                  <EPICSField name="PHAS" value="9"/>
                  <EPICSField name="PINI" value="YES"/>
                  <EPICSField name="SCAN" value="1 second"/>
                  <EPICSField name="THST" value="Not Operational"/>
                  <EPICSField name="THSV" value="MAJOR"/>
                  <EPICSField name="THVL" value="3"/>
                  <EPICSField name="TWST" value="Partially Operational(2)"/>
                  <EPICSField name="TWSV" value="MINOR"/>
                  <EPICSField name="TWVL" value="2"/>
                  <EPICSField name="ZRST" value="Fully Operational"/>
                  <EPICSField name="ZRSV" value="NO_ALARM"/>
                  <EPICSField name="ZRVL" value="0"/>
               </EPICSRecord>
            </EPICSAttributes>
            <BEASTAttributes>
               <pv xmlns="http://www.iter.org/CODAC/BEAST/2012"
                    name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLT">
                  <enabled>true</enabled>
                  <description>Any one of CPU, MEM, Disk, FD, Process of the host is in alarm state</description>
                  <latching>true</latching>
                  <annunciating>false</annunciating>
                  <delay>0</delay>
                  <guidance>
                     <title>System is an abnormal state</title>
                     <details>Check the mentioned alarm load and identify the cause</details>
                  </guidance>
                  <display>
                     <title>System Health Alarm OPI</title>
                     <details>/opt/codac/opi/boy/resources/alarmpages/healthMonitoring/ITER-SYSM-SHLT_Alarm.opi "CBS=$(CBS), PPPP=$(PPPP), PP=$(PP), TTT=$(TTT), NNNN=$(NNNN), ALARM_PV=$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLT, ALARM_PATH=$(ALARM_PATH), LEVEL=$(BOY_LEVEL), ALARM_GUIDANCE1_TITLE=System resource utilization is high, ALARM_GUIDANCE1_DETAILS=Any one of CPU / MEM / Disk / FD / Process of the host is in alarm state. Check the mentioned alarm load and identify the cause. If any load remains high continuously contact maintenance service."</details>
                  </display>
                  <guidance>
                     <title>System resources related to the alarm</title>
                     <details>1 - one of CPU, Disk, Memory, FD load is high or necessary process has been stopped
2 - two of CPU, Disk, Memory, FD load are high and/or necessary process has been stopped
3 - three of CPU, Disk, Memory, FD load are high and/or necessary process has been stopped</details>
                  </guidance>
                  <guidance>
                     <title>Corrective action</title>
                     <details>If any load remains high continuously, contact maintenance service.
                                        In addition, check if the necessary processes are running</details>
                  </guidance>
                  <guidance>
                     <title>Temporary actions to suppress</title>
                     <details>Change the alarm limits or severity for each load in alarm state.

  Ex1) alarm limits
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.HIGH 90
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CPUUTL.HIHI 100

  Ex2) alarm severity
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.HSV NO_ALARM
	% caput $(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-MEMUTL.HHSV NO_ALARM</details>
                  </guidance>
               </pv>
            </BEASTAttributes>
            <PULSEAttributes>
               <attribute name="isConfiguredByPulseScheduling">
                  <value>false</value>
               </attribute>
            </PULSEAttributes>
         </variableTemplate>
         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-BTIME">
            <direction>state</direction>
