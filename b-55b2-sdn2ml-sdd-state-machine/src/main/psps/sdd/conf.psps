         <variableTemplate name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PICMG">
            <direction>state</direction>
            <kind>continuous</kind>
            <external>true</external>
            <raisesAlarm>false</raisesAlarm>
            <archivingInfo enabled="false">
               <samplingFrequency>0.0</samplingFrequency>
            </archivingInfo>
            <storage>volatile</storage>
            <presentOnScreens>false</presentOnScreens>
            <displayIndex>0</displayIndex>
            <EPICSAttributes>
               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-PICMG" type="calcout">
                  <EPICSField name="CALC" value="((A&gt;=1?1:0)+(B&gt;=1?1:0)+(C&gt;=1?1:0))&gt;=1?1:0"/>
                  <EPICSField name="DESC" value="Health calculation for PICMG sensors"/>
                  <EPICSField name="FLNK" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-SHLTCS"/>
                  <EPICSField name="INPA" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CTEMPMAX.SEVR"/>
                  <EPICSField name="INPB" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CTEMPMIN.SEVR"/>
                  <EPICSField name="INPC" value="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-CTEMPAVG.SEVR"/>
