               <EPICSRecord name="$(CBS)-$(PPPP)-$(PP):$(TTT)$(NNNN)-FDUTL" type="ai">
                  <EPICSField name="ADEL" value="10"/>
                  <EPICSField name="AFTC" value="60"/>
