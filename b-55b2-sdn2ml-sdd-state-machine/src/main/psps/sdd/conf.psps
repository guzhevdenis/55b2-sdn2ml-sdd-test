                  <EPICSField name="DESC" value="Process Status List"/>
                  <EPICSField name="DTYP" value="sysmon"/>
                  <EPICSField name="FTVL" value="STRING"/>
                  <EPICSField name="INP" value="@proc_sts"/>
                  <EPICSField name="NELM" value="20"/>
                  <EPICSField name="PINI" value="YES"/>
