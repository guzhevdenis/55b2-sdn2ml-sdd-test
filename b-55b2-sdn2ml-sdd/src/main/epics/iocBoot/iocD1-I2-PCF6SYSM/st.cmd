< envPaths
< envSystem
< envUser

cd "${TOP}"

############################################################################
## Register all support components
############################################################################

dbLoadDatabase "dbd/D1-I2.dbd"
D1_I2_registerRecordDeviceDriver pdbbase

< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/sddPreDriverConf.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/userPreDriverConf.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/threadSchedulingConf.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/dbToLoad.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/iocD1-I2-PCF6SYSM-preSaveRestore.cmd"

############################################################################
## IOC Logging
############################################################################
iocLogInit
iocLogPrefix "${STY} : "

############################################################################
## IOC initialization
############################################################################
cd "${TOP}/db"
iocInit

< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/iocD1-I2-PCF6SYSM-postSaveRestore.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/sddSeqToLoad.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/seqToLoad.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/sddPostDriverConf.cmd"
< "${TOP}/iocBoot/iocD1-I2-PCF6SYSM/userPostDriverConf.cmd"


dbl > "${CODAC_VAR}/iocdump/${UNIT_NAME}/${IOC_NAME}-${IOC_BOOT_TIME}.dbl"
dbla > "${CODAC_VAR}/iocdump/${UNIT_NAME}/${IOC_NAME}-${IOC_BOOT_TIME}.dbla"
dbior > "${CODAC_VAR}/iocdump/${UNIT_NAME}/${IOC_NAME}-${IOC_BOOT_TIME}.dbior"
dbhcr > "${CODAC_VAR}/iocdump/${UNIT_NAME}/${IOC_NAME}-${IOC_BOOT_TIME}.dbhcr"

