# Master STMs for all DAQ publishers
record(mbbo, "D1-I2-DAQ-StateMachine-setState") {
    field(DESC, "Set states for all DAQ publisher STMs")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(ONVL, 1)
    field(ONST, "OFF")
    field(FRVL, 4)
    field(FRST, "ON")
    field(SVVL, 7)
    field(SVST, "RUNNING")
}

record(mbbi, "D1-I2-DAQ-StateMachine-getState") {
    field(DESC, "Get state from all DAQ publisher STMs")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
}

