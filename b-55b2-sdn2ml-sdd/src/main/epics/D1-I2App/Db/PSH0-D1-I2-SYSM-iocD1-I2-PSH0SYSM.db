record (mbbi,"D1-I2-SYSM--:PSHPSH-SHLT")
{
	field(DESC, "Synthesis Health Status")
	field(INP, "D1-I2-SYSM--:PSHPSH-SHLTC")
	field(ONST, "Partially Operational(1)")
	field(ONSV, "MINOR")
	field(ONVL, "1")
	field(PHAS, "9")
	field(PINI, "YES")
	field(SCAN, "1 second")
	field(THST, "Not Operational")
	field(THSV, "MAJOR")
	field(THVL, "3")
	field(TWST, "Partially Operational(2)")
	field(TWSV, "MINOR")
	field(TWVL, "2")
	field(ZRST, "Fully Operational")
	field(ZRSV, "NO_ALARM")
	field(ZRVL, "0")
}

record (calcout,"D1-I2-SYSM--:PSHPSH-SHLTC")
{
	field(CALC, "(A>=3?3:A)")
	field(DESC, "Final Calculation for SHLT")
	field(FLNK, "D1-I2-SYSM--:PSHPSH-SHLT")
	field(INPA, "D1-I2-SYSM--:PSHPSH-SHLTCS")
	field(PHAS, "8")
	field(SCAN, "1 second")
}

record (calcout,"D1-I2-SYSM--:PSHPSH-SHLTCL")
{
	field(CALC, "(A>=1?1:0)+(B>=1?1:0)+(C>=1?1:0)+(D>=1?1:0)+((E>=1?1:0)||(F>=1?1:0))")
	field(DESC, "Local PV calculation for SHLT")
	field(FLNK, "D1-I2-SYSM--:PSHPSH-SHLTCS")
	field(INPA, "D1-I2-SYSM--:PSHPSH-CPUUTL.SEVR")
	field(INPB, "D1-I2-SYSM--:PSHPSH-MEMUTL.SEVR")
	field(INPC, "D1-I2-SYSM--:PSHPSH-DISKUTL.SEVR")
	field(INPD, "D1-I2-SYSM--:PSHPSH-FDUTL.SEVR")
	field(INPE, "D1-I2-SYSM--:PSHPSH-PS.SEVR")
	field(INPF, "D1-I2-SYSM--:PSHPSH-PROCSTS.SEVR")
	field(PHAS, "6")
	field(SCAN, "1 second")
}

record (calcout,"D1-I2-SYSM--:PSHPSH-SHLTCS")
{
	field(CALC, "A+(B>=1?1:0)+(C>=1?1:0)")
	field(DESC, "Calculation for synthesis health status")
	field(FLNK, "D1-I2-SYSM--:PSHPSH-SHLTC")
	field(INPA, "D1-I2-SYSM--:PSHPSH-SHLTCL")
	field(INPB, "D1-I2-SYSM--:PSHPSH-PICMG")
	field(INPC, "D1-I2-SYSM--:PSHPSH-CFA")
	field(PHAS, "7")
	field(SCAN, "1 second")
}

record (calcout,"D1-I2-SYSM--:PSHPSH-SYSHLT")
{
	field(CALC, "((A>=1?1:0)|(B>=1?2:0)|(C>=1?4:0)|(D>=1?8:0))&(B>2?0:15)")
	field(DESC, "System health")
	field(FLNK, "D1-I2-SYSM--:PSHPSH-SYSHLTS")
	field(HIGH, "1")
	field(HSV, "MINOR")
	field(INPA, "D1-I2-SYSM--:PSHPSH-CPUUTL.SEVR")
	field(INPB, "D1-I2-SYSM--:PSHPSH-MEMUTL.SEVR")
	field(INPC, "D1-I2-SYSM--:PSHPSH-DISKUTL.SEVR")
	field(INPD, "D1-I2-SYSM--:PSHPSH-FDUTL.SEVR")
	field(SCAN, "1 second")
}

