# HMI controls (added for the test-stand OPI; were not present initially).
record(ao, "$(PREFIX)-BaseRate") {
    field(DESC, "SIMULATOR shared count-rate setpoint")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(DEVICE),0)BaseRate")
    field(EGU, "cps")
    field(PREC, "2")
    field(PINI, "YES")
    field(VAL, "1000")
    field(DRVL, "0")
    field(DRVH, "1e7")
}

record(bo, "$(PREFIX)-Enable") {
    field(DESC, "SIMULATOR generation start/stop")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn($(DEVICE),0)Enable")
    field(ZNAM, "STOP")
    field(ONAM, "START")
    field(PINI, "YES")
    field(VAL, "0")
}

record(bi, "$(PREFIX)-EnableRBV") {
    field(DESC, "SIMULATOR generation running")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(DEVICE),0)EnableRBV")
    field(SCAN, "I/O Intr")
    field(ZNAM, "STOPPED")
    field(ONAM, "RUNNING")
}

record(mbbi, "$(PREFIX)-StateMachine-getGlobalState") {
    field(DESC, "Get global DAQ generator state")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(INP, "@asyn($(DEVICE), 0)StateMachine-getGlobalState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
}

record(mbbi, "$(PREFIX)-StateMachine-getState") {
    field(DESC, "Get local DAQ generator state")
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(PINI, 1)
    field(INP, "@asyn($(DEVICE), 0)StateMachine-getState")
    field(ZRVL, 0)
    field(ZRST, "UNKNOWN")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(TWVL, 2)
    field(TWST, "SWITCHING_OFF")
    field(THVL, 3)
    field(THST, "INITIALIZING")
    field(FRVL, 4)
    field(FRST, "ON")
    field(FVVL, 5)
    field(FVST, "STOPPING")
    field(SXVL, 6)
    field(SXST, "STARTING")
    field(SVVL, 7)
    field(SVST, "RUNNING")
    field(EIVL, 8)
    field(EIST, "FAULT")
}

record(mbbo, "$(PREFIX)-StateMachine-setState") {
    field(DESC, "Set local DAQ generator state")
    field(DTYP, "asynInt32")
    field(SCAN, "Passive")
    field(PINI, 1)
    field(OUT, "@asyn($(DEVICE), 0)StateMachine-setState")
    field(ONVL, 1)
    field(ONST, "OFF")
    field(FRVL, 4)
    field(FRST, "ON")
    field(SVVL, 7)
    field(SVST, "RUNNING")
}
