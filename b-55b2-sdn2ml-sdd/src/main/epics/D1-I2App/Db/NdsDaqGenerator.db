# SIMULATOR nds-daq-generator: 8 count-rate channels (no hardware).
# Naming follows 55b2-vnc-sdd Nds3Sender CountRate PV, numbered 00..07.

record(ai, "$(PREFIX)-CountRate00") {
    field(DESC, "SIMULATOR count rate ch00")
    field(DTYP, "asynFloat64")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(DEVICE),0)CountRate00")
    field(EGU, "cps")
    field(PREC, "2")
}

record(ai, "$(PREFIX)-CountRate01") {
    field(DESC, "SIMULATOR count rate ch01")
    field(DTYP, "asynFloat64")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(DEVICE),0)CountRate01")
    field(EGU, "cps")
    field(PREC, "2")
}

